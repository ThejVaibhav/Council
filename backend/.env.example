# Copy to backend/.env and fill in. Never commit .env.
# Groq is the default (free key at https://console.groq.com/keys).
LLM_PROVIDER=groq
GROQ_API_KEY=
SPECIALIST_MODEL=openai/gpt-oss-20b
MODERATOR_MODEL=openai/gpt-oss-120b
# Gemini is the automatic fallback when Groq fails or is rate limited (free key at https://aistudio.google.com/apikey).
GEMINI_API_KEY=
GEMINI_SPECIALIST_MODEL=gemini-3.5-flash
GEMINI_MODERATOR_MODEL=gemini-3.7-flash
AGENT_TIMEOUT_SECONDS=45
# Parallel debates allowed; each makes 7 Gemini calls, so keep this low on the free tier.
MAX_CONCURRENT_DEBATES=2
DATABASE_URL=postgresql://council:council@localhost:55432/council
CORS_ORIGINS=http://localhost:5288

# Optional: OAuth web client id for "Continue with Google"
GOOGLE_CLIENT_ID=
